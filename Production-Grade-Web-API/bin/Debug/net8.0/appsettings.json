{
    "ConnectionStrings": {
        "DefaultConnection": "Server=(local);Database=ProductionGradeWebApiDb;Trusted_Connection=True;Encrypt=false;TrustServerCertificate=true;"
    },
    "Jwt": {
        "Secret": "your-super-secret-key-min-32-characters-long-for-jwt-signing!",
        "ExpireMinutes": 60,
        "Issuer": "Production.Grade.WebApi",
        "Audience": "Production.Grade.WebApi.Client"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.AspNetCore": "Information"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ]
    },
    "AllowedHosts": "*"
}
